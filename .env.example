TELEGRAM_BOT_TOKEN=
WUWATERM_DB_PATH=data/terms.db
WUWATERM_DATA_DIR=data/wutheringdata
WUWATERM_STATE_DIR=state
WUWATERM_SOURCE_PROFILE=arikatsu

# Optional OpenAI-compatible LLM endpoint, for example LiteLLM.
WUWATERM_OPENAI_BASE_URL=
WUWATERM_OPENAI_API_KEY=
WUWATERM_OPENAI_MODEL=

# Invalid numeric/boolean values fail startup without echoing the raw value.
# Timeout range: 0.1..300 seconds; concurrency range: 1..64.
WUWATERM_LLM_TIMEOUT_SECONDS=45
WUWATERM_LLM_MAX_CONCURRENCY=4
# Per-chat request limit range: 1..10000 per minute.
WUWATERM_RATE_LIMIT_PER_MINUTE=10

# Optional HMAC key for stable, non-raw Telegram id redaction in logs and smoke output.
# Leave empty to preserve the legacy deterministic SHA-256 redaction.
WUWATERM_REDACTION_SECRET=

# /tr and /sentence authorization: group and private rejection wording, plus
# an optional silent mode (1/true to drop unauthorized calls without replying).
#WUWATERM_GROUP_TR_REJECT_TEXT=仅群管理员可用 /tr
#WUWATERM_PRIVATE_TR_REJECT_TEXT=此 bot 仅限群内由管理员使用
WUWATERM_TR_REJECT_SILENT=0

# Private /tr answers only this Telegram user id. Missing or empty means
# private chat rejects everyone (fail-closed) and logs a startup warning.
OWNER_USER_ID=

# Linked-channel auto-translation. Boolean tokens: 1/true/yes/on or
# 0/false/no/off. CJK/Latin thresholds: 1..4096; text: 1..4096;
# caption: 1..1024.
WUWATERM_CHANNEL_AUTOTRANSLATE=1
WUWATERM_CHANNEL_MIN_CJK=1
WUWATERM_CHANNEL_MIN_LATIN=2
WUWATERM_CHANNEL_TEXT_LIMIT=4096
WUWATERM_CHANNEL_CAPTION_LIMIT=1024

# Process-local linked-channel admission bounds. A long post reserves all of
# its 2000-character LLM chunks before the first call. Pending range: 0..1024;
# call budget range: 1..10000 per rolling minute.
WUWATERM_CHANNEL_MAX_PENDING=16
WUWATERM_CHANNEL_LLM_CALLS_PER_MINUTE=60

# Channel replay horizon in seconds, range 1..2592000 (30 days).
WUWATERM_CHANNEL_MAX_AGE_SECONDS=86400

# Channel post -> bot reply ids are persisted here for restart-safe edits.
# Default: WUWATERM_STATE_DIR/channel_replies.json when WUWATERM_STATE_DIR is
# set; otherwise alongside WUWATERM_DB_PATH for local compatibility.
# For Docker, remove old data/channel_replies.json overrides or point them here.
#WUWATERM_CHANNEL_REPLY_INDEX_PATH=state/channel_replies.json

# /public per-chat toggle and allowlist are persisted as JSON here.
# Default: WUWATERM_STATE_DIR/chat_settings.json when WUWATERM_STATE_DIR is set;
# otherwise alongside WUWATERM_DB_PATH for local compatibility.
# For Docker, remove old data/chat_settings.json overrides or point them here.
#WUWATERM_SETTINGS_PATH=state/chat_settings.json

# HTTP adapter (separate process, same image). Under Compose it binds host
# loopback only and that bind is fixed in deploy/docker-compose.yml, not here:
# the service uses host networking, so making the bind an environment knob
# would turn a public exposure into a one-line edit. Port range 1..65535.
WUWATERM_API_PORT=8788
# Device credential store. A SIBLING of the bot's state directory, never a
# child of it: the bot mounts the whole of state/ read-write.
WUWATERM_API_STATE_DIR=state-api
# API budgets are per process and are NOT shared with the bot. The documented
# worst case is the sum of the two processes' budgets.
# Model concurrency 1..64; call and request budgets 1..10000 per minute;
# body cap 64..1048576 bytes; request time budget 1..600 seconds.
WUWATERM_API_LLM_MAX_CONCURRENCY=2
WUWATERM_API_LLM_CALLS_PER_MINUTE=30
WUWATERM_API_LLM_TIMEOUT_SECONDS=45
WUWATERM_API_RATE_LIMIT_PER_MINUTE=30
WUWATERM_API_MAX_BODY_BYTES=32768
WUWATERM_API_REQUEST_TIMEOUT_SECONDS=90
# How much this service writes about itself. One structured record is emitted
# per request (correlation id, method, route, status, duration, and the
# redacted device principal when one authenticated); INFO is where those live.
# CRITICAL, ERROR, WARNING, INFO or DEBUG. Applied as the process level, the
# way the bot applies WUWATERM_LOG_LEVEL; separate from uvicorn's own
# `--log-level`, which covers the web server rather than these records.
WUWATERM_API_LOG_LEVEL=INFO
# How many credential verifications may run at once. Verification is
# deliberately expensive, so this bounds it. Range 1..64.
WUWATERM_API_AUTH_MAX_CONCURRENCY=2
