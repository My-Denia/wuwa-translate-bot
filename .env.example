TELEGRAM_BOT_TOKEN=
WUWATERM_DB_PATH=data/terms.db
WUWATERM_SOURCE_PROFILE=arikatsu

# Optional OpenAI-compatible LLM endpoint, for example LiteLLM.
WUWATERM_OPENAI_BASE_URL=
WUWATERM_OPENAI_API_KEY=
WUWATERM_OPENAI_MODEL=
WUWATERM_RATE_LIMIT_PER_MINUTE=10

# /tr and /sentence authorization: group and private rejection wording, plus
# an optional silent mode (1/true to drop unauthorized calls without replying).
#WUWATERM_GROUP_TR_REJECT_TEXT=仅群管理员可用 /tr
#WUWATERM_PRIVATE_TR_REJECT_TEXT=此 bot 仅限群内由管理员使用
WUWATERM_TR_REJECT_SILENT=0

# Private /tr answers only this Telegram user id. Missing or empty means
# private chat rejects everyone (fail-closed) and logs a startup warning.
OWNER_USER_ID=

# Linked-channel auto-translation: kill switch (default on; 0/false/no/off disables), min CJK ideographs to trigger, text/caption length caps.
WUWATERM_CHANNEL_AUTOTRANSLATE=1
WUWATERM_CHANNEL_MIN_CJK=1
WUWATERM_CHANNEL_TEXT_LIMIT=4096
WUWATERM_CHANNEL_CAPTION_LIMIT=1024

# Channel posts older than this many seconds are never auto-translated (guards against Telegram update replays).
WUWATERM_CHANNEL_MAX_AGE_SECONDS=300
