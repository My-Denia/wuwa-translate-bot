# Client-local build residue. `build.ps1` runs PyInstaller in this directory,
# so its output lands here rather than at the repository root; without these
# rules a build leaves a bundled interpreter and Qt runtime in front of the
# repository hygiene gate.
dist/
build/

# Per-component development virtualenv and caches. The root .gitignore already
# covers these names, and they are repeated here so this directory stays safe
# to build in on its own.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
