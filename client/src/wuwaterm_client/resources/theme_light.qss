/* WuwaTerm 亮色主题。占位符由 theme.py 的 LIGHT_TOKENS 在加载时替换。 */

/*
 * 这份文件与 theme_dark.qss 是同一份模板的两次取值:除本行上方的抬头注释
 * 外,两者的规则必须逐字一致,差异只允许出现在令牌的取值里。
 * test_theme_resources.py 会比对这一点——某个语义色只在一套里有定义,正是这
 * 套方案最容易出的那类缺陷。
 *
 * 三条贯穿全文的约定:
 *  - 控件尺寸一律 min-height + padding,不用定高。150%/200% 缩放下定高会裁字。
 *  - 焦点是 2px 边框;常态 1px 边框的控件在焦点态把 padding 各减 1px,
 *    否则控件的视觉尺寸会在获得焦点时跳一下。
 *  - 需要背景或边框的容器请用 QFrame(或它的子类)。裸 QWidget 不画样式表
 *    给的背景,这是 Qt 的既有行为,不是这份样式表的疏漏。
 */

/* ---------------------------------------------------------------- 基底 */

QWidget {
    background-color: @bg-canvas@;
    color: @text-primary@;
    font-family: @font-family@;
    font-size: @font-size-body@;
}

QMainWindow,
QDialog,
QStackedWidget {
    background-color: @bg-canvas@;
}

/* QFrame 是容器的默认形态,所以默认什么都不画;要背景的容器靠 objectName
 * 取回来(id 选择器比类型选择器更具体)。 */
QFrame {
    background-color: transparent;
    border: none;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QToolTip {
    background-color: @bg-surface@;
    color: @text-primary@;
    border: 1px solid @border-strong@;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: @font-size-secondary@;
}

/* ---------------------------------------------------------------- 文本 */

QLabel {
    background-color: transparent;
    border: none;
    color: @text-primary@;
}

QLabel:disabled {
    color: @text-muted@;
}

#pageTitle {
    font-size: @font-size-title@;
    font-weight: 600;
    color: @text-primary@;
    padding: 0px 0px 8px 0px;
}

/* 首启与令牌录入对话框复用同一个 objectName 承载标题,只是放大到 display。 */
QDialog #pageTitle {
    font-size: @font-size-display@;
    padding: 0px 0px 12px 0px;
}

#sectionTitle {
    font-size: @font-size-section@;
    font-weight: 500;
    color: @text-secondary@;
}

#cardTitle {
    font-size: @font-size-section@;
    font-weight: 500;
    color: @text-primary@;
}

#monoLabel {
    font-family: @font-family-mono@;
    font-size: @font-size-caption@;
    color: @text-muted@;
}

#fieldError {
    font-size: @font-size-caption@;
    color: @danger@;
    padding: 2px 0px 0px 0px;
}

#statusStrip {
    background-color: @bg-canvas@;
    border-top: 1px solid @border-subtle@;
    color: @text-muted@;
    font-size: @font-size-caption@;
    min-height: 28px;
    padding: 4px 12px;
}

/* -------------------------------------------------------------- 导航栏 */

#navBar {
    background-color: @bg-canvas@;
    border-right: 1px solid @border-subtle@;
}

#navItem {
    background-color: transparent;
    color: @text-secondary@;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    font-size: @font-size-body@;
    min-height: 40px;
    padding: 4px 12px;
    text-align: left;
}

#navItem:hover {
    background-color: @bg-sunken@;
    color: @text-primary@;
}

#navItem:focus {
    background-color: @bg-sunken@;
    color: @text-primary@;
    border-left: 3px solid @focus-ring@;
}

#navItem:checked {
    background-color: @accent-soft-bg@;
    color: @accent-soft-fg@;
    border-left: 3px solid @accent@;
    font-weight: 500;
}

/* 地址芯片:圆点说状态,文字说地址。两者的 state 取值必须同步设置。 */
#endpointChip {
    background-color: @bg-surface@;
    border: 1px solid @border-subtle@;
    border-radius: 999px;
    min-height: 24px;
    padding: 4px 12px;
    font-size: @font-size-caption@;
    color: @text-secondary@;
}

#endpointChip[state="ok"] {
    background-color: @success-soft@;
    border: 1px solid @success@;
}

#endpointChip[state="missing"] {
    background-color: @danger-soft@;
    border: 1px solid @danger@;
}

#endpointDot {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border: none;
    border-radius: 4px;
    background-color: @text-muted@;
}

#endpointDot[state="ok"] {
    background-color: @success@;
}

#endpointDot[state="missing"] {
    background-color: @danger@;
}

/* ---------------------------------------------------------- 卡片与空态 */

#card {
    background-color: @bg-surface@;
    border: 1px solid @border-subtle@;
    border-radius: 10px;
    padding: 16px;
}

#emptyCard {
    background-color: @bg-sunken@;
    border: 1px solid @border-subtle@;
    border-radius: 10px;
    padding: 24px;
}

#emptyTitle {
    font-size: @font-size-section@;
    font-weight: 500;
    color: @text-primary@;
}

#emptySubtitle {
    font-size: @font-size-secondary@;
    color: @text-secondary@;
}

#stepList {
    background-color: transparent;
    border: none;
}

#stepItem {
    font-size: @font-size-secondary@;
    color: @text-secondary@;
    padding: 4px 0px;
}

#stepItem[done="true"] {
    color: @success@;
}

#stepItem[done="false"] {
    color: @text-primary@;
}

/* ---------------------------------------------------------------- 提示条 */

#banner {
    background-color: @bg-sunken@;
    border: 1px solid @border-subtle@;
    border-left: 4px solid @border-strong@;
    border-radius: 10px;
    padding: 12px;
}

#banner[severity="danger"] {
    background-color: @danger-soft@;
    border: 1px solid @danger@;
    border-left: 4px solid @danger@;
}

#banner[severity="warn"] {
    background-color: @warn-soft@;
    border: 1px solid @warn@;
    border-left: 4px solid @warn@;
}

#banner[severity="info"] {
    background-color: @info-soft@;
    border: 1px solid @info@;
    border-left: 4px solid @info@;
}

#bannerIcon {
    background-color: transparent;
    font-weight: 600;
    color: @text-secondary@;
    padding: 0px 4px 0px 0px;
}

#banner[severity="danger"] #bannerIcon {
    color: @danger@;
}

#banner[severity="warn"] #bannerIcon {
    color: @warn@;
}

#banner[severity="info"] #bannerIcon {
    color: @info@;
}

#bannerText {
    background-color: transparent;
    color: @text-primary@;
    font-size: @font-size-secondary@;
}

#bannerActions {
    background-color: transparent;
    border: none;
}

/* ------------------------------------------------------------ 来源徽章 */

#kindBadge {
    background-color: @bg-sunken@;
    border: 1px solid @border-subtle@;
    border-radius: 999px;
    min-height: 22px;
    padding: 2px 12px;
    font-size: @font-size-secondary@;
    color: @text-secondary@;
}

#kindBadge[kind="exact"] {
    background-color: @success-soft@;
    border: 1px solid @success@;
    color: @success@;
}

#kindBadge[kind="fuzzy"] {
    background-color: @warn-soft@;
    border: 1px solid @warn@;
    color: @warn@;
}

#kindBadge[kind="llm"] {
    background-color: @info-soft@;
    border: 1px solid @info@;
    color: @info@;
}

#kindBadge[kind="noop"] {
    background-color: @bg-sunken@;
    border: 1px solid @border-strong@;
    color: @text-muted@;
}

/* 四态的几何形状全部由这里画,不用位图、不用图标字体:形 + 色 + 字三重
 * 编码,灰度截图和色觉障碍下都还能分辨。 */
#kindDot {
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
    border: none;
    border-radius: 4px;
    background-color: @text-muted@;
}

#kindDot[kind="exact"] {
    background-color: @success@;
    border: none;
    border-radius: 4px;
}

#kindDot[kind="fuzzy"] {
    background-color: transparent;
    border: 2px solid @warn@;
    border-radius: 4px;
}

#kindDot[kind="llm"] {
    background-color: @info@;
    border: none;
    border-radius: 2px;
}

#kindDot[kind="noop"] {
    min-width: 10px;
    max-width: 10px;
    min-height: 2px;
    max-height: 2px;
    background-color: @text-muted@;
    border: none;
    border-radius: 0px;
}

/* ------------------------------------------------------------ 按钮 */

QPushButton {
    background-color: @bg-surface@;
    color: @text-primary@;
    border: 1px solid @border-subtle@;
    border-radius: 6px;
    min-height: 32px;
    padding: 4px 16px;
    font-size: @font-size-body@;
}

QPushButton:hover {
    background-color: @bg-sunken@;
    border: 1px solid @border-strong@;
}

QPushButton:pressed {
    background-color: @bg-sunken@;
    border: 1px solid @border-strong@;
}

QPushButton:focus {
    border: 2px solid @focus-ring@;
    padding: 3px 15px;
}

QPushButton:disabled {
    background-color: @bg-sunken@;
    color: @text-muted@;
    border: 1px solid @border-subtle@;
}

#primaryButton {
    background-color: @accent@;
    color: @accent-fg@;
    border: 1px solid @accent@;
    font-weight: 500;
}

#primaryButton:hover {
    background-color: @accent-hover@;
    border: 1px solid @accent-hover@;
}

#primaryButton:pressed {
    background-color: @accent-hover@;
    border: 1px solid @accent-hover@;
}

/* 焦点环用前景色而不是 accent:填充色本身就是 accent,同色的环等于没有环。 */
#primaryButton:focus {
    border: 2px solid @accent-fg@;
    padding: 3px 15px;
}

#primaryButton:disabled {
    background-color: @bg-sunken@;
    color: @text-muted@;
    border: 1px solid @border-subtle@;
}

#secondaryButton {
    background-color: transparent;
    color: @text-secondary@;
    border: 1px solid @border-strong@;
}

#secondaryButton:hover {
    background-color: @bg-sunken@;
    color: @text-primary@;
    border: 1px solid @border-strong@;
}

#secondaryButton:focus {
    border: 2px solid @focus-ring@;
    padding: 3px 15px;
}

#secondaryButton:disabled {
    background-color: transparent;
    color: @text-muted@;
    border: 1px solid @border-subtle@;
}

#linkButton {
    background-color: transparent;
    color: @accent@;
    border: none;
    border-radius: 6px;
    min-height: 24px;
    padding: 4px 8px;
    text-align: left;
}

#linkButton:hover {
    background-color: transparent;
    color: @accent-hover@;
    border: none;
    text-decoration: underline;
}

#linkButton:focus {
    border: 2px solid @focus-ring@;
    padding: 2px 6px;
}

#linkButton:disabled {
    background-color: transparent;
    color: @text-muted@;
    border: none;
}

/* -------------------------------------------------------------- 输入 */

QLineEdit,
QPlainTextEdit,
QTextEdit {
    background-color: @bg-surface@;
    color: @text-primary@;
    border: 1px solid @border-subtle@;
    border-radius: 6px;
    min-height: 32px;
    padding: 4px 12px;
    font-size: @font-size-body@;
    selection-background-color: @accent@;
    selection-color: @accent-fg@;
}

QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover {
    border: 1px solid @border-strong@;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border: 2px solid @focus-ring@;
    padding: 3px 11px;
}

QLineEdit:disabled,
QPlainTextEdit:disabled,
QTextEdit:disabled {
    background-color: @bg-sunken@;
    color: @text-muted@;
    border: 1px solid @border-subtle@;
}

QLineEdit:read-only,
QPlainTextEdit:read-only,
QTextEdit:read-only {
    background-color: @bg-sunken@;
}

/* 字段级错误:描边转 danger,配一行 #fieldError 文本。设置 property 之后
 * 必须 unpolish/polish,否则这条规则不会重算。 */
QLineEdit[invalid="true"],
QPlainTextEdit[invalid="true"],
QTextEdit[invalid="true"],
QDoubleSpinBox[invalid="true"] {
    border: 1px solid @danger@;
}

QLineEdit[invalid="true"]:focus,
QPlainTextEdit[invalid="true"]:focus,
QTextEdit[invalid="true"]:focus,
QDoubleSpinBox[invalid="true"]:focus {
    border: 2px solid @danger@;
    padding: 3px 11px;
}

QLineEdit[invalid="false"],
QPlainTextEdit[invalid="false"],
QTextEdit[invalid="false"],
QDoubleSpinBox[invalid="false"] {
    border: 1px solid @border-subtle@;
}

#searchField {
    min-height: 32px;
    padding: 4px 12px;
    font-size: @font-size-body@;
}

#searchField:focus {
    padding: 3px 11px;
}

/* ------------------------------------------------------------ 下拉框 */

QComboBox {
    background-color: @bg-surface@;
    color: @text-primary@;
    border: 1px solid @border-subtle@;
    border-radius: 6px;
    min-height: 32px;
    padding: 4px 12px;
    font-size: @font-size-body@;
}

QComboBox:hover {
    border: 1px solid @border-strong@;
}

QComboBox:focus {
    border: 2px solid @focus-ring@;
    padding: 3px 11px;
}

QComboBox:disabled {
    background-color: @bg-sunken@;
    color: @text-muted@;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background-color: transparent;
}

/* 零宽零高 + 三条边框 = 一个向下的三角。同样是纯几何,不引入位图。 */
QComboBox::down-arrow {
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid @text-secondary@;
}

QComboBox::down-arrow:disabled {
    border-top: 4px solid @text-muted@;
}

QComboBox QAbstractItemView {
    background-color: @bg-surface@;
    color: @text-primary@;
    border: 1px solid @border-strong@;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    selection-background-color: @accent-soft-bg@;
    selection-color: @accent-soft-fg@;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: @accent-soft-bg@;
    color: @accent-soft-fg@;
}

/* -------------------------------------------------------- 数值输入框 */

QDoubleSpinBox,
QSpinBox {
    background-color: @bg-surface@;
    color: @text-primary@;
    border: 1px solid @border-subtle@;
    border-radius: 6px;
    min-height: 32px;
    padding: 4px 8px;
    font-size: @font-size-body@;
    selection-background-color: @accent@;
    selection-color: @accent-fg@;
}

QDoubleSpinBox:hover,
QSpinBox:hover {
    border: 1px solid @border-strong@;
}

QDoubleSpinBox:focus,
QSpinBox:focus {
    border: 2px solid @focus-ring@;
    padding: 3px 7px;
}

QDoubleSpinBox:disabled,
QSpinBox:disabled {
    background-color: @bg-sunken@;
    color: @text-muted@;
}

QDoubleSpinBox::up-button,
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    background-color: transparent;
}

QDoubleSpinBox::down-button,
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border: none;
    background-color: transparent;
}

QDoubleSpinBox::up-arrow,
QSpinBox::up-arrow {
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 4px solid @text-secondary@;
}

QDoubleSpinBox::down-arrow,
QSpinBox::down-arrow {
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid @text-secondary@;
}

/* ------------------------------------------------------------ 单选钮 */

QRadioButton {
    background-color: transparent;
    color: @text-primary@;
    spacing: 8px;
    min-height: 24px;
    padding: 2px 0px;
}

QRadioButton:disabled {
    color: @text-muted@;
}

/* 圆角取指示器边长的一半:超大的 999px 在这个子控件上不会被裁成圆形,
   单选钮会画成方块,和复选框长得一样。 */
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid @border-strong@;
    border-radius: 8px;
    background-color: @bg-surface@;
}

QRadioButton::indicator:hover {
    border: 1px solid @accent@;
}

QRadioButton::indicator:checked {
    background-color: @accent@;
    border: 1px solid @accent@;
}

QRadioButton::indicator:disabled {
    background-color: @bg-sunken@;
    border: 1px solid @border-subtle@;
}

/* -------------------------------------------------------------- 表格 */

QTableView,
QTableWidget {
    background-color: @bg-surface@;
    alternate-background-color: @bg-sunken@;
    color: @text-primary@;
    border: 1px solid @border-subtle@;
    border-radius: 10px;
    gridline-color: @border-subtle@;
    outline: none;
    selection-background-color: @accent-soft-bg@;
    selection-color: @accent-soft-fg@;
}

QTableView::item,
QTableWidget::item {
    border: none;
    min-height: 32px;
    padding: 4px 8px;
}

QTableView::item:selected,
QTableWidget::item:selected {
    background-color: @accent-soft-bg@;
    color: @accent-soft-fg@;
}

QHeaderView {
    background-color: @bg-surface@;
    border: none;
}

QHeaderView::section {
    background-color: @bg-surface@;
    color: @text-secondary@;
    border: none;
    border-bottom: 1px solid @border-strong@;
    font-size: @font-size-secondary@;
    font-weight: 500;
    min-height: 28px;
    padding: 4px 8px;
}

QHeaderView::section:hover {
    color: @text-primary@;
}

QTableCornerButton::section {
    background-color: @bg-surface@;
    border: none;
    border-bottom: 1px solid @border-strong@;
}

/* ------------------------------------------------------------ 滚动条 */

QScrollBar:vertical {
    background-color: transparent;
    border: none;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: @border-strong@;
    border-radius: 4px;
    margin: 2px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: @text-muted@;
}

QScrollBar:horizontal {
    background-color: transparent;
    border: none;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: @border-strong@;
    border-radius: 4px;
    margin: 2px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: @text-muted@;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    border: none;
    background-color: transparent;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background-color: transparent;
}

/* ---------------------------------------------------------- 进度指示 */

QProgressBar {
    background-color: @bg-sunken@;
    color: @text-secondary@;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    text-align: center;
    font-size: @font-size-caption@;
}

QProgressBar::chunk {
    background-color: @accent@;
    border-radius: 4px;
}

/* 输入槽上的加载线:压成 2px,不显示文字(由调用方 setTextVisible(False))。 */
#progressLine {
    background-color: @bg-sunken@;
    border: none;
    border-radius: 0px;
    min-height: 2px;
    max-height: 2px;
}

#progressLine::chunk {
    background-color: @accent@;
    border-radius: 0px;
}

/* 查词结果的相关度细条:40px 宽,按 0-100 填充。 */
#scoreBar {
    background-color: @bg-sunken@;
    border: none;
    border-radius: 999px;
    min-width: 40px;
    max-width: 40px;
    min-height: 4px;
    max-height: 4px;
}

/* 填充是 ScoreBar 内的一个 QFrame,不是 QProgressBar 的 ::chunk 子控件 —— 
   写成子控件选择器时它匹配不到任何东西,细条会整条透明。 */
#scoreBarFill {
    background-color: @accent@;
    border: none;
    border-radius: 999px;
}

/* ------------------------------------------------------------ 菜单 */

QMenuBar {
    background-color: @bg-canvas@;
    color: @text-primary@;
    border: none;
    border-bottom: 1px solid @border-subtle@;
    padding: 2px 4px;
}

QMenuBar::item {
    background-color: transparent;
    border-radius: 6px;
    padding: 4px 12px;
}

QMenuBar::item:selected {
    background-color: @accent-soft-bg@;
    color: @accent-soft-fg@;
}

QMenuBar::item:pressed {
    background-color: @accent-soft-bg@;
    color: @accent-soft-fg@;
}

QMenu {
    background-color: @bg-surface@;
    color: @text-primary@;
    border: 1px solid @border-strong@;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    background-color: transparent;
    border-radius: 4px;
    min-height: 28px;
    padding: 4px 24px 4px 12px;
}

QMenu::item:selected {
    background-color: @accent-soft-bg@;
    color: @accent-soft-fg@;
}

QMenu::item:disabled {
    color: @text-muted@;
}

QMenu::separator {
    background-color: @border-subtle@;
    height: 1px;
    margin: 4px 8px;
}

/* -------------------------------------------------- 分组框与保留的弹窗 */

QGroupBox {
    background-color: @bg-surface@;
    border: 1px solid @border-subtle@;
    border-radius: 10px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-size: @font-size-section@;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0px 4px;
    background-color: @bg-surface@;
    color: @text-secondary@;
}

/* 全应用只保留两处模态(遗忘令牌的确认、关于)。它们由 Qt 自己构造,拿不到
 * objectName,所以这里给的是兜底样式——没有它们,这两处会以未设计的原生外观
 * 出现在一套自定义主题里。 */
QMessageBox {
    background-color: @bg-surface@;
}

QMessageBox QLabel {
    background-color: transparent;
    color: @text-primary@;
    font-size: @font-size-body@;
}

QMessageBox QPushButton {
    min-width: 88px;
    min-height: 32px;
}

QMessageBox QPushButton:default {
    background-color: @accent@;
    color: @accent-fg@;
    border: 1px solid @accent@;
    font-weight: 500;
}

QMessageBox QPushButton:default:hover {
    background-color: @accent-hover@;
    border: 1px solid @accent-hover@;
}

QDialogButtonBox {
    background-color: transparent;
}
