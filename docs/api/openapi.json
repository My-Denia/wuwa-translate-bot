  "info": {
    "description": "Read-only translation surface for the Wuthering Waves terminology service.\n\nThis API uses the application pipeline also used by Telegram command routes\nand the in-process private web layer: official dictionary hit first, then a\ntrusted pinyin hit, then a term-locked model call. Linked-channel\nauto-translation has specialized channel orchestration and is not part of this\nAPI contract. Responses are plain text; rich-text markup is never part of this\ncontract.\n\nAuthentication is a bearer device token issued by the operator. There is no\nregistration endpoint: tokens are created out of band and can be revoked.",
    "title": "wuwaterm API",
    "version": "0.4.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Liveness. Answers as long as the process is serving; no auth.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseBody"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Readiness: the terminology database is readable right now. No auth.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseBody"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseBody"
                }
              }
            },
            "description": "The terminology database is not readable. Classified as `internal`; the 503 status is what distinguishes it."
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/meta": {
      "get": {
        "description": "Service and data provenance. No paths, no secrets, no chat ids.",
        "operationId": "read_meta_v1_meta_get",
        "responses": {
          "200": {
